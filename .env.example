# PostgreSQL connection string. On Railway, set this to
# ${{Postgres.DATABASE_URL}} once a Postgres service is attached.
DATABASE_URL="postgresql://user:password@host:5432/khaleyya"

# Random string, at least 32 characters, used to sign session cookies.
# Generate one with: openssl rand -base64 48
SESSION_SECRET="change-this-to-a-long-random-secret-value"

NODE_ENV="production"

# Used only by `npm run db:seed` to create the first store + admin login.
# Change these before running the seed against a real deployment, then
# rotate the password from inside the app afterwards.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_STORE_NAME="اسم متجرك"
SEED_ADMIN_NAME="اسمك"
